<mujoco model="eqr11w">
  <compiler angle="radian" meshdir="../meshes/"/>
  <!-- 感知光学坐标系试验版：由 eqr11w.xml 复制而来（2026-09-10），原文件 eqr11w.xml 未改动。
       新增每个相机的 rgb / depth / laser 三个光学 site；depth 为深度扫描射线原点。
       偏移依据 Orbbec Gemini 335Le 规格书(330 系列 Datasheet)：表 4-8-1 深度原点=左 IR 光心(0)、
       彩色(RGB)光心 X=+23.75mm（X 向右为正）；表 4-9-1 深度与 RGB 的 Z 零点相同(4.080mm)；
       LDM 激光器 X=+47.5mm（四元件等距 23.75mm + 规格书"RGB 位于 LDM 左侧"推得）。
       本机型 CAD 帧的惯量质心 +48.884mm ≈ 模块几何中心 +47.5mm ⇒ CAD 帧原点=深度原点。
       若机械确认帧原点另有基准（如安装孔），三者整体平移即可，相对间距不变。 -->
  <option timestep="0.0005" iterations="50" solver="PGS" gravity="0 0 -9.81">
    <flag frictionloss="enable"/>
  </option>
  <size njmax="500" nconmax="100"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <quality shadowsize="4096"/>
    <map znear="0.0001"/>
  </visual>

  <default>
    <joint limited="true" damping="0.6" frictionloss="0.1" armature="0.1"/>
    <motor ctrllimited="true"/>
    <geom condim="3" contype="1" conaffinity="15" solref="0.001 2" friction="0.9 0.2 0.2"/>
    <equality solref="0.0005 2"/>
    <default class="visualgeom">
      <geom material="visualgeom" condim="3" contype="0" conaffinity="0"/>
    </default>
    <default class="obstacle">
      <geom material="obstacle" condim="3" contype="1" conaffinity="15"/>
    </default>

    <default class="EC-A8116-P1-18">
      <!-- EC-A8116-P1-18: 额定扭矩40Nm, 峰值扭矩130Nm, 减速比18, 重量961g -->
      <!-- 电机级摩擦≈0.025Nm, 摩擦系数=0.025×18=0.45; 粘滞阻尼=0.0007×18²≈0.23 -->
      <joint damping="0.23" frictionloss="0.45" armature="0.061236"/>
    </default>
    <default class="EC-A10020-P1-12">
      <!-- EC-A10020-P1-12: 额定扭矩50Nm, 峰值扭矩150Nm, 减速比12, 重量1373g, 转子惯量485kg·mm² -->
      <!-- 电机级摩擦≈0.035Nm, 摩擦系数=0.035×12=0.42; 粘滞阻尼=0.001×12²≈0.14 -->
      <joint damping="0.14" frictionloss="0.42" armature="0.06984"/>
    </default>
    <!-- 膝关节: 在EC-A10020-P1-12基础上额外加了一对齿轮, 减速比1.632, 总减速比=12×1.632=19.584, 反射惯量=485e-6×19.584²=0.186 -->
    <!-- 电机级摩擦≈0.036Nm(含附加齿轮), 摩擦系数=0.036×19.584≈0.7; 粘滞阻尼=0.0013×19.584²≈0.5 -->
    <default class="EC-A10020-P1-12-Knee">
      <joint damping="0.5" frictionloss="0.7" armature="0.186013"/>
    </default>
    <!-- EC-A6408-P2-25: 额定扭矩20Nm, 峰值扭矩60Nm, 减速比25, 重量625g, 转子惯量62kg·mm² -->
    <!-- 电机级摩擦≈0.015Nm, 摩擦系数=0.015×25=0.38; 粘滞阻尼=0.0004×25²≈0.25 -->
    <default class="EC-A6408-P2-25">
      <joint damping="0.25" frictionloss="0.38" armature="0.03875"/>
    </default>


  </default>

